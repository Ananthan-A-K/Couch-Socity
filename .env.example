# ===============================================
# Couch Society — Root Environment Configuration
# ===============================================

# Backend Server Port
PORT=3001

# Allowed Frontend URL(s) for CORS (comma-separated for multiple origins)
# For local development:
CLIENT_URL=http://localhost:5173

# For production deployment (replace with your Vercel frontend URL):
# CLIENT_URL=https://couch-society.vercel.app,https://your-custom-domain.com

# Node Environment
NODE_ENV=production
