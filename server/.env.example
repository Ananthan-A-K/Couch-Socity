# ===============================================
# Couch Socity — Backend Server Environment
# ===============================================

# Port to bind the Express / Socket.IO server
PORT=3001

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# Local development:
CLIENT_URL=http://localhost:5173

# Production (replace with your Vercel production deployment URL):
# CLIENT_URL=https://couch-socity.vercel.app

# Environment
NODE_ENV=production
