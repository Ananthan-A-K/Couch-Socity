{
  "name": "couch-socity-server",
  "version": "1.0.0",
  "description": "Backend server for Couch Socity Pong game",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
